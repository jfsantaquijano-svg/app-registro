{
  "name": "app-registro",
  "version": "1.0.0",
  "private": true,
  "description": "App web instalable para registrar comida, entreno y cuerpo. Funciona sin internet.",
  "type": "module",
  "scripts": {
    "servir": "python3 -m http.server 8080",
    "test": "node --test \"test/unit/*.test.mjs\" && node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.mjs\""
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
